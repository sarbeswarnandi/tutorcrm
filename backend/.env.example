# Default uses SQLite for zero-setup instant local running
DATABASE_URL=sqlite+aiosqlite:///./tutor.db

# When you are ready to connect your free Supabase PostgreSQL, uncomment and fill this:
# Notice the port 6543 (PgBouncer Transaction Pooler) which prevents cold-start connection limits
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Teacher/Coaching Settings for Zero-Budget UPI and Reminders
TEACHER_NAME=Sharma Tutorials
TEACHER_UPI_ID=sharma.maths@okaxis
